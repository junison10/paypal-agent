# PayPal Agent — environment variables
# Copy to .env and fill in. Never commit .env (it is git-ignored).
# This app uses the PayPal SANDBOX only — never put live credentials here.

# PayPal Sandbox credentials (required for real sandbox captures;
# if left empty the server runs in mock mode with fake order/capture IDs).
# Get them free at https://developer.paypal.com :
#   sign in -> My Apps & Credentials -> Sandbox -> Create App
#   -> copy the Client ID and Secret below.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# PayPal environment. Keep "sandbox" — this app never uses live mode.
PAYPAL_MODE=sandbox

# OpenAI API key for LLM intent parsing (optional).
# If unset, the built-in rule-based parser is used instead.
OPENAI_API_KEY=

# Model used for intent parsing (only used when OPENAI_API_KEY is set).
OPENAI_MODEL=gpt-4o-mini

# HTTP port for the local server.
PORT=3000
